  updatedAt   DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  @@index([status, availableAt, lockedUntil], map: "idx_outbox_dispatch")
  @@index([aggregateType, aggregateId], map: "idx_outbox_aggregate")
  @@map("outbox_events")
}
