model Ticket {
  id            String       @id @default(uuid()) @db.Char(36)
  ticketCode    String       @unique(map: "uq_tickets_code") @map("ticket_code") @db.VarChar(12)
  orderItemId   String       @unique(map: "uq_tickets_order_item") @map("order_item_id") @db.Char(36)
  orderId       String       @map("order_id") @db.Char(36)
  showtimeId    String       @map("showtime_id") @db.Char(36)
  seatId        String       @map("seat_id") @db.Char(36)
  status        TicketStatus @default(VALID)
  qrKeyVersion  Int          @default(1) @map("qr_key_version") @db.UnsignedInt
  checkedInAt   DateTime?    @map("checked_in_at") @db.DateTime(3)
  checkedInBy   String?      @map("checked_in_by") @db.Char(36)
  createdAt     DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  item          OrderItem    @relation(fields: [orderItemId, orderId, showtimeId, seatId], references: [id, orderId, showtimeId, seatId], onDelete: Restrict)
  checker       User?        @relation("TicketChecker", fields: [checkedInBy], references: [id], onDelete: Restrict)
  @@unique([orderItemId, orderId, showtimeId, seatId], map: "uq_tickets_item_relation")
  @@index([orderId, status], map: "idx_tickets_order_status")
  @@index([showtimeId, status], map: "idx_tickets_showtime_status")
  @@index([checkedInBy, checkedInAt], map: "idx_tickets_checkin")
  @@map("tickets")
}

model Payment {
  id                String          @id @default(uuid()) @db.Char(36)
  orderId           String          @map("order_id") @db.Char(36)
  attemptNo         Int             @map("attempt_no") @db.UnsignedInt
  provider          PaymentProvider
  method            PaymentMethod
  txnRef            String          @map("txn_ref") @db.VarChar(100)
  gatewayTxnNo      String?         @map("gateway_txn_no") @db.VarChar(100)
  amount            Int             @db.UnsignedInt
  status            PaymentStatus   @default(PENDING)
  paymentUrl        String?         @map("payment_url") @db.Text
  requestExpiresAt  DateTime        @map("request_expires_at") @db.DateTime(3)
  responseCode      String?         @map("response_code") @db.VarChar(50)
  failureReason     String?         @map("failure_reason") @db.VarChar(1000)
  paidAt            DateTime?       @map("paid_at") @db.DateTime(3)
  recordedBy        String?         @map("recorded_by") @db.Char(36)
  cashReceived      Int?            @map("cash_received") @db.UnsignedInt
  cashChange        Int?            @map("cash_change") @db.UnsignedInt
  note              String?         @db.VarChar(1000)
  createdAt         DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  order             Order           @relation("OrderPayments", fields: [orderId], references: [id], onDelete: Restrict)
  settledOrder      Order?          @relation("OrderSettlement")
  recorder          User?           @relation("PaymentRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  logs              PaymentLog[]
  refund            RefundRequest?
  @@unique([id, orderId], map: "uq_payments_id_order")
  @@unique([orderId, attemptNo], map: "uq_payments_attempt")
  @@unique([provider, txnRef], map: "uq_payments_provider_ref")
  @@unique([provider, gatewayTxnNo], map: "uq_payments_gateway_transaction")
  @@index([status, requestExpiresAt], map: "idx_payments_expiry")
  @@map("payments")
}

model PaymentLog {
  id             String            @id @default(uuid()) @db.Char(36)
