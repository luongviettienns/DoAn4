  method        RefundMethod?
  amount        Int                 @db.UnsignedInt
  cancellationFee Int               @default(0) @map("cancellation_fee") @db.UnsignedInt
  policySnapshot Json               @map("policy_snapshot")
  requestedBy   String?             @map("requested_by") @db.Char(36)
  processedBy   String?             @map("processed_by") @db.Char(36)
  processedAt   DateTime?           @map("processed_at") @db.DateTime(3)
  externalReference String?         @map("external_reference") @db.VarChar(255)
