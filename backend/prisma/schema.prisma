  payment        Payment?          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  @@index([paymentId, createdAt], map: "idx_payment_logs_payment")
  @@index([provider, txnRef, createdAt], map: "idx_payment_logs_ref")
  @@map("payment_logs")
}

