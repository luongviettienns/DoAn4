NODE_ENV=development
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=mysql://root:password@127.0.0.1:3306/cinema_booking_dev
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
CSRF_SECRET=your_csrf_secret_key_minimum_32_characters_long
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d
QR_SECRET=your_qr_secret_key_minimum_32_characters_long
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax
EMAIL_VERIFY_REQUIRED=false

# VNPay Sandbox
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/v1/payment/vnpay/return
VNPAY_IPN_URL=https://your-public-tunnel.ngrok.app/api/v1/payment/vnpay/ipn
FRONTEND_PAYMENT_RESULT_URL=http://localhost:5173/payment/result

# Media & Uploads
MEDIA_ROOT=./uploads
